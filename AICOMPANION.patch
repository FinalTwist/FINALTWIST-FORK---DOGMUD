+	GreetOnLogin                 bool
+	MoodDecayMinutes             int
+	LogDecisions                 bool
+	PromptMemories               int
+	MaxMemories                  int
+	MaxFacts                     int
+	MaxSummaries                 int
+	ReflectOnLogout              bool
+	MinSessionLinesForReflection int
