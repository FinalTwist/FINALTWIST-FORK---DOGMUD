+			usr.WriteString(l)
+			usr.WriteString("\n")
+		}
+		usr.WriteString("\n")
+	}
+
+	if len(in.Quests) > 0 && !in.Brief {
+		fmt.Fprintf(&usr, "WHAT %s IS IN THE MIDDLE OF (you can help, and remember where it sent you; you cannot do any of it for them)\n", strings.ToUpper(owner))
+		for _, l := range in.Quests {
+			usr.WriteString("- ")
+			usr.WriteString(l)
+			usr.WriteString("\n")
+		}
+		usr.WriteString("\n")
