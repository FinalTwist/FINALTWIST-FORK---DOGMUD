+		}
+		usr.WriteString("\n")
+	}
+
+	if len(in.OwnPhrases) > 0 && !in.Brief {
+		usr.WriteString("THINGS YOU HAVE SAID OR DONE LATELY (do not repeat them or their wording)\n")
+		for _, ph := range in.OwnPhrases {
+			fmt.Fprintf(&usr, "- %q\n", ph)
